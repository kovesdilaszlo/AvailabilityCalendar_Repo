@model AvailabilityCalendar.Web.ViewModels.Calendar.CalendarPageViewModel
@using AvailabilityCalendar.Domain.Enums
@using AvailabilityCalendar.Web.ViewModels.Calendar
@using System.Globalization

@{
    ViewData["Title"] = "Naptár";

    var isSharedMode = Model.Mode == ViewMode.Shared;
    var dayViewClass = Model.ViewType == CalendarViewType.Day ? "day-view" : "week-view";

    string FormatCssNumber(double value)
    {
        return value.ToString("0.####", CultureInfo.InvariantCulture);
    }

    string FormatDateTimeValue(DateTime value)
    {
        return value.ToString("yyyy-MM-ddTHH:mm");
    }

    string GetBlockClass(CalendarBlockViewModel block)
    {
        return block.IsFreeTime ? "free" : "event";
    }
}

<div class="calendar-page py-4">
    <div class="container-fluid px-3 px-xl-4">

        <div class="calendar-card p-4 mb-4">
            <div class="d-flex flex-column flex-xl-row justify-content-between gap-3">
                <div>
                    <h1 class="page-title">Naptár</h1>
                    <p class="page-subtitle">@Model.ModeLabel</p>
                </div>

                <div class="d-flex flex-wrap gap-2 align-items-start">
                    <a asp-controller="Calendar"
                       asp-action="Create"
                       asp-route-date="@Model.CurrentDate.ToString("yyyy-MM-dd")"
                       class="btn btn-primary">
                        Új esemény
                    </a>
                </div>
            </div>
        </div>

        <div class="calendar-card p-4 mb-4">
            <form asp-controller="Calendar" asp-action="Index" method="get">
                <input type="hidden" name="date" value="@Model.CurrentDate.ToString("yyyy-MM-dd")" />

                <div class="calendar-toolbar-grid">
                    <div>
                        <label class="form-label fw-semibold">Nézet</label>
                        <select class="form-select" name="view" onchange="this.form.submit()">
                            @if (Model.ViewType == CalendarViewType.Day)
                            {
                                <option value="Day" selected>Napi</option>
                            }
                            else
                            {
                                <option value="Day">Napi</option>
                            }

                            @if (Model.ViewType == CalendarViewType.Week)
                            {
                                <option value="Week" selected>Heti</option>
                            }
                            else
                            {
                                <option value="Week">Heti</option>
                            }

                            @if (Model.ViewType == CalendarViewType.Month)
                            {
                                <option value="Month" selected>Havi</option>
                            }
                            else
                            {
                                <option value="Month">Havi</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label fw-semibold">Minimum szabad idősáv</label>
                        <input class="form-control"
                               type="number"
                               min="1"
                               name="minimumDurationMinutes"
                               value="@Model.MinimumDurationMinutes"
                               onchange="this.form.submit()" />
                    </div>

                    <div>
                        <label class="form-label fw-semibold">Idősáv darabolása</label>
                        <input class="form-control"
                               type="number"
                               min="1"
                               name="slotLengthMinutes"
                               value="@Model.SlotLengthMinutes"
                               placeholder="Nincs darabolás"
                               onchange="this.form.submit()" />
                    </div>
                </div>

                <div class="mt-4">
                    <label class="form-label fw-semibold">Felhasználók kiválasztása</label>

                    <div class="user-selection-chips">
                        @foreach (var user in Model.AvailableUsers)
                        {
                            var inputId = $"user-{user.Id}";

                            <div class="user-chip-item">
                                <input id="@inputId"
                                       class="user-chip-input"
                                       type="checkbox"
                                       name="selectedUsers"
                                       value="@user.Id"
                                       checked="@user.IsSelected"
                                       onchange="this.form.submit()" />

                                <label class="user-chip-label" for="@inputId">
                                    <span class="user-chip-text">@user.Name</span>
                                </label>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit"
                            name="date"
                            value="@DateTime.Today.ToString("yyyy-MM-dd")"
                            class="btn btn-outline-secondary">
                        Ugrás a mai napra
                    </button>
                </div>
            </form>
        </div>

        <div class="calendar-card p-4 mb-4">
            <div class="calendar-nav">
                <form asp-controller="Calendar" asp-action="Index" method="get">
                    <input type="hidden" name="date" value="@Model.PreviousDate.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="view" value="@Model.ViewType" />
                    <input type="hidden" name="minimumDurationMinutes" value="@Model.MinimumDurationMinutes" />

                    @if (Model.SlotLengthMinutes.HasValue)
                    {
                        <input type="hidden" name="slotLengthMinutes" value="@Model.SlotLengthMinutes.Value" />
                    }

                    @foreach (var selectedUserId in Model.SelectedUserIds)
                    {
                        <input type="hidden" name="selectedUsers" value="@selectedUserId" />
                    }

                    <button type="submit" class="btn btn-outline-primary">
                        ← Előző
                    </button>
                </form>

                <div class="calendar-period">
                    <div class="calendar-period-label">Aktuális időszak</div>
                    <div class="calendar-period-value">@Model.CurrentPeriodLabel</div>
                </div>

                <form asp-controller="Calendar" asp-action="Index" method="get">
                    <input type="hidden" name="date" value="@Model.NextDate.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="view" value="@Model.ViewType" />
                    <input type="hidden" name="minimumDurationMinutes" value="@Model.MinimumDurationMinutes" />

                    @if (Model.SlotLengthMinutes.HasValue)
                    {
                        <input type="hidden" name="slotLengthMinutes" value="@Model.SlotLengthMinutes.Value" />
                    }

                    @foreach (var selectedUserId in Model.SelectedUserIds)
                    {
                        <input type="hidden" name="selectedUsers" value="@selectedUserId" />
                    }

                    <button type="submit" class="btn btn-outline-primary">
                        Következő →
                    </button>
                </form>
            </div>
        </div>

        <div class="calendar-card overflow-hidden">
            @if (Model.ViewType == CalendarViewType.Month)
            {
                <div class="calendar-grid-wrapper">
                    <div class="calendar-month-grid">
                        <div class="calendar-month-header">Hétfő</div>
                        <div class="calendar-month-header">Kedd</div>
                        <div class="calendar-month-header">Szerda</div>
                        <div class="calendar-month-header">Csütörtök</div>
                        <div class="calendar-month-header">Péntek</div>
                        <div class="calendar-month-header">Szombat</div>
                        <div class="calendar-month-header">Vasárnap</div>

                        @foreach (var cell in Model.Cells)
                        {
                            var cellClasses = new List<string> { "calendar-month-cell" };

                            if (!cell.IsCurrentPeriod)
                            {
                                cellClasses.Add("other-month");
                            }

                            if (cell.IsToday)
                            {
                                cellClasses.Add("today");
                            }

                            if (cell.IsSelectedDate)
                            {
                                cellClasses.Add("selected");
                            }

                            var cellBlocks = Model.Blocks
                                .Where(b => b.Date.Date == cell.Date.Date)
                                .OrderBy(b => b.Start)
                                .ToList();

                            <div class="@string.Join(" ", cellClasses)">
                                <div class="calendar-month-date">
                                    @cell.Date.Day
                                </div>

                                <div class="calendar-month-items">
                                    @foreach (var block in cellBlocks.Take(4))
                                    {
                                        if (block.IsFreeTime)
                                        {
                                            <button type="button"
                                                    class="calendar-month-item calendar-month-item-button free"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#createFromFreeSlotModal"
                                                    data-start="@FormatDateTimeValue(block.Start)"
                                                    data-end="@FormatDateTimeValue(block.End)"
                                                    data-redirect-date="@Model.CurrentDate.ToString("yyyy-MM-dd")">
                                                <span class="calendar-month-item-time">@block.TimeLabel</span>
                                                <span>@block.Title</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="calendar-month-item calendar-month-item-button event"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editEventModal"
                                                    data-event-id="@block.EventId"
                                                    data-title="@block.Title"
                                                    data-start="@FormatDateTimeValue(block.Start)"
                                                    data-end="@FormatDateTimeValue(block.End)">
                                                <span class="calendar-month-item-time">@block.TimeLabel</span>
                                                <span>@block.Title</span>
                                            </button>
                                        }
                                    }

                                    @if (cellBlocks.Count > 4)
                                    {
                                        <div class="calendar-month-item">
                                            + @(cellBlocks.Count - 4) további
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="calendar-grid-wrapper">
                    <div class="calendar-time-shell">

                        <div class="calendar-time-header @dayViewClass">
                            <div class="calendar-time-header-axis"></div>

                            @foreach (var cell in Model.Cells)
                            {
                                var headerClasses = new List<string> { "calendar-time-header-cell" };

                                if (cell.IsToday)
                                {
                                    headerClasses.Add("today");
                                }

                                if (cell.IsSelectedDate)
                                {
                                    headerClasses.Add("selected");
                                }

                                <div class="@string.Join(" ", headerClasses)">
                                    <div class="calendar-time-header-title">
                                        @cell.Date.ToString("dddd")
                                    </div>
                                    <div class="calendar-time-header-date">
                                        @cell.Date.ToString("yyyy.MM.dd.")
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="calendar-time-body @dayViewClass">
                            <div class="calendar-time-axis">
                                @foreach (var hour in Model.HourLabels)
                                {
                                    var topPercent = FormatCssNumber(((hour - Model.DayStartHour) / (double)(Model.DayEndHour - Model.DayStartHour)) * 100.0);
                                    var labelClass = hour == Model.DayEndHour
                                        ? "calendar-time-axis-label last"
                                        : "calendar-time-axis-label";

                                    <div class="@labelClass" style="top:@topPercent%;">
                                        @hour.ToString("00"):00
                                    </div>
                                }
                            </div>

                            <div class="calendar-time-columns @dayViewClass">
                                @for (var columnIndex = 0; columnIndex < Model.Cells.Count; columnIndex++)
                                {
                                    var cell = Model.Cells[columnIndex];

                                    var columnClasses = new List<string> { "calendar-time-column" };

                                    if (cell.IsToday)
                                    {
                                        columnClasses.Add("today");
                                    }

                                    var cellBlocks = Model.Blocks
                                        .Where(b => b.Date.Date == cell.Date.Date)
                                        .OrderBy(b => b.Start)
                                        .ToList();

                                    <div class="@string.Join(" ", columnClasses)">
                                        @for (var hour = Model.DayStartHour; hour < Model.DayEndHour; hour++)
                                        {
                                            var hourTopPercent = FormatCssNumber(((hour - Model.DayStartHour) / (double)(Model.DayEndHour - Model.DayStartHour)) * 100.0);

                                            <div class="calendar-hour-line" style="top:@hourTopPercent%;"></div>
                                            <div class="calendar-hour-band" style="top:@hourTopPercent%;"></div>
                                        }

                                        @foreach (var block in cellBlocks)
                                        {
                                            var top = FormatCssNumber(block.TopPercent);
                                            var height = FormatCssNumber(block.HeightPercent);
                                            var blockClass = GetBlockClass(block);

                                            if (block.IsFreeTime)
                                            {
                                                <button type="button"
                                                        class="calendar-block calendar-block-button @blockClass"
                                                        style="top:@top%; height:@height%;"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#createFromFreeSlotModal"
                                                        data-start="@FormatDateTimeValue(block.Start)"
                                                        data-end="@FormatDateTimeValue(block.End)"
                                                        data-redirect-date="@Model.CurrentDate.ToString("yyyy-MM-dd")">
                                                    <div class="calendar-block-time">@block.TimeLabel</div>
                                                    <div class="calendar-block-title">@block.Title</div>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="calendar-block calendar-block-button @blockClass"
                                                        style="top:@top%; height:@height%;"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#editEventModal"
                                                        data-event-id="@block.EventId"
                                                        data-title="@block.Title"
                                                        data-start="@FormatDateTimeValue(block.Start)"
                                                        data-end="@FormatDateTimeValue(block.End)">
                                                    <div class="calendar-block-time">@block.TimeLabel</div>
                                                    <div class="calendar-block-title">@block.Title</div>
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="createFromFreeSlotModal" tabindex="-1" aria-labelledby="createFromFreeSlotModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Calendar" asp-action="CreateFromFreeSlot" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title" id="createFromFreeSlotModalLabel">Szabad idősáv lefoglalása</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Bezárás"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="freeSlotStart" name="start" />
                    <input type="hidden" id="freeSlotEnd" name="end" />
                    <input type="hidden" name="redirectDate" value="@Model.CurrentDate.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="redirectView" value="@Model.ViewType" />
                    <input type="hidden" name="minimumDurationMinutes" value="@Model.MinimumDurationMinutes" />

                    @if (Model.SlotLengthMinutes.HasValue)
                    {
                        <input type="hidden" name="slotLengthMinutes" value="@Model.SlotLengthMinutes.Value" />
                    }

                    @foreach (var selectedUserId in Model.SelectedUserIds)
                    {
                        <input type="hidden" name="participantIds" value="@selectedUserId" />
                    }

                    <div class="mb-3">
                        <label class="form-label text-muted">Kiválasztott közös szabad idősáv</label>
                        <div id="freeSlotLabel" class="fw-semibold"></div>
                    </div>

                    <div class="mb-3">
                        <label for="freeSlotTitle" class="form-label">Esemény címe</label>
                        <input id="freeSlotTitle"
                               name="title"
                               class="form-control"
                               value="Közös esemény"
                               required />
                    </div>

                    <div class="alert alert-info mb-0">
                        Ha megerősíted, az esemény az összes jelenleg kiválasztott felhasználóhoz résztvevőként kapcsolódik.
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Mégse</button>
                    <button type="submit" class="btn btn-success">Létrehozás megerősítése</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editEventModal" tabindex="-1" aria-labelledby="editEventModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Calendar" asp-action="Update" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title" id="editEventModalLabel">Esemény módosítása</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Bezárás"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="editEventId" name="Id" />
                    <input type="hidden" name="redirectDate" value="@Model.CurrentDate.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="redirectView" value="@Model.ViewType" />
                    <input type="hidden" name="minimumDurationMinutes" value="@Model.MinimumDurationMinutes" />

                    @if (Model.SlotLengthMinutes.HasValue)
                    {
                        <input type="hidden" name="slotLengthMinutes" value="@Model.SlotLengthMinutes.Value" />
                    }

                    @foreach (var selectedUserId in Model.SelectedUserIds)
                    {
                        <input type="hidden" name="selectedUsers" value="@selectedUserId" />
                    }

                    <div class="mb-3">
                        <label for="editEventTitle" class="form-label">Cím</label>
                        <input id="editEventTitle" name="Title" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label for="editEventStart" class="form-label">Kezdés</label>
                        <input id="editEventStart" name="Start" type="datetime-local" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label for="editEventEnd" class="form-label">Befejezés</label>
                        <input id="editEventEnd" name="End" type="datetime-local" class="form-control" required />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Mégse</button>
                    <button type="submit" class="btn btn-primary">Mentés</button>
                </div>
            </form>

            <form asp-controller="Calendar" asp-action="Delete" method="post" class="px-3 pb-3">
                @Html.AntiForgeryToken()

                <input type="hidden" id="deleteEventId" name="id" />
                <input type="hidden" name="redirectDate" value="@Model.CurrentDate.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="redirectView" value="@Model.ViewType" />
                <input type="hidden" name="minimumDurationMinutes" value="@Model.MinimumDurationMinutes" />

                @if (Model.SlotLengthMinutes.HasValue)
                {
                    <input type="hidden" name="slotLengthMinutes" value="@Model.SlotLengthMinutes.Value" />
                }

                @foreach (var selectedUserId in Model.SelectedUserIds)
                {
                    <input type="hidden" name="selectedUsers" value="@selectedUserId" />
                }

                <button type="submit" class="btn btn-outline-danger w-100">
                    Esemény törlése
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const createFromFreeSlotModal = document.getElementById('createFromFreeSlotModal');

        if (createFromFreeSlotModal) {
            createFromFreeSlotModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;

                if (!button) {
                    return;
                }

                const start = button.getAttribute('data-start');
                const end = button.getAttribute('data-end');

                const startInput = document.getElementById('freeSlotStart');
                const endInput = document.getElementById('freeSlotEnd');
                const label = document.getElementById('freeSlotLabel');

                startInput.value = start;
                endInput.value = end;

                label.textContent = formatDateTimeForDisplay(start) + ' - ' + formatDateTimeForDisplay(end);
            });
        }

        const editEventModal = document.getElementById('editEventModal');

        if (editEventModal) {
            editEventModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;

                if (!button) {
                    return;
                }

                const eventId = button.getAttribute('data-event-id');
                const title = button.getAttribute('data-title');
                const start = button.getAttribute('data-start');
                const end = button.getAttribute('data-end');

                document.getElementById('editEventId').value = eventId;
                document.getElementById('deleteEventId').value = eventId;
                document.getElementById('editEventTitle').value = title;
                document.getElementById('editEventStart').value = start;
                document.getElementById('editEventEnd').value = end;
            });
        }

        function formatDateTimeForDisplay(value) {
            if (!value) {
                return '';
            }

            const parsed = new Date(value);

            if (Number.isNaN(parsed.getTime())) {
                return value;
            }

            const year = parsed.getFullYear();
            const month = String(parsed.getMonth() + 1).padStart(2, '0');
            const day = String(parsed.getDate()).padStart(2, '0');
            const hour = String(parsed.getHours()).padStart(2, '0');
            const minute = String(parsed.getMinutes()).padStart(2, '0');

            return `${year}-${month}-${day} ${hour}:${minute}`;
        }
    </script>
}